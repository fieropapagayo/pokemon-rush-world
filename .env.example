# Configuración del servidor de Pokémon Rush World
# Copia este archivo como .env (run.bat lo hace automáticamente la primera vez).

# Puerto HTTP + WebSocket (el juego se abre en http://localhost:PUERTO)
PORT=3000

# Interfaz de red: 0.0.0.0 acepta conexiones de la red local (LAN). 127.0.0.1 = solo este PC.
HOST=0.0.0.0

# Archivo de la base de datos SQLite
DB_FILE=data/pokemon-rush.db

# Nombre mostrado a los jugadores
SERVER_NAME=Servidor Pokémon Rush World

# Máximo de jugadores conectados a la vez
MAX_PLAYERS=50

# Denominador base shiny; se multiplica según rareza/especie (x1 a x16).
SHINY_RATE=4096

# Permitir entrar como invitado (true / false)
ALLOW_GUESTS=true

# Comandos de prueba "/dev ..." en el chat. Déjalo en false salvo para probar en local.
DEV_CHEATS=false

# ---- Nube (opcional): copias de seguridad + web de ranking en Cloudflare (gratis) ----
# Despliega la carpeta web/ (web/desplegar.bat) y copia aquí la dirección y la clave que te muestra.
CLOUD_URL=
CLOUD_KEY=
# Identificador de este servidor en la web de estado
CLOUD_SERVER_ID=principal
# Dirección pública del juego para el botón "Jugar ahora" de la web (por ejemplo tu enlace de Cloudflare Tunnel)
PUBLIC_URL=
# Abre sola una dirección pública https://xxxx.trycloudflare.com al arrancar (necesita cloudflared en el PC servidor).
# La web fija .../jugar siempre lleva a la dirección vigente. Pon false para jugar solo en casa (LAN).
TUNNEL=true
# Botón "Entrar con Google" en el menú (necesita la web de Cloudflare con GOOGLE_CLIENT_ID configurado)
GOOGLE_LOGIN=true
